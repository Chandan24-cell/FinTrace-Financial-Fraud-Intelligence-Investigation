# Sentinel-G — Oracle Cloud Free Tier deployment env template.
# Copy this to `.env` on the VM, fill every value, then `docker compose up -d`.
# DO NOT commit the filled-in `.env` — it's already in the repo's .gitignore.

# --- Caddy reverse-proxy ---------------------------------------------------
# DuckDNS subdomain that Caddy auto-issues a Let's Encrypt cert for.
# Sign up at https://duckdns.org (GitHub OAuth), claim the subdomain, and
# point its A record at the VM's public IP via the install-time + cron curl.
DOMAIN=sentinel-g.duckdns.org

# --- Neo4j (Railway) -------------------------------------------------------
# From Railway → Sentinel-G project → Neo4j service → Settings → Networking.
# After "Generate Domain" with TCP Proxy on port 7687, paste the host:port
# below. NEO4J_URI uses the `bolt://` scheme (Railway terminates TLS at the
# proxy, so the in-cluster traffic is plain Bolt).
NEO4J_URI=bolt://<railway-tcp-proxy-host>:<port>
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set-in-railway-NEO4J_AUTH-variable>
NEO4J_DATABASE=neo4j

# --- FastAPI auth ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<64-hex-chars>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
RATE_LIMIT_PER_MIN=10

# --- Gemini Flash narrative ------------------------------------------------
# https://aistudio.google.com/apikey — free tier 60 req/min is plenty for demo.
GEMINI_API_KEY=<your-google-ai-studio-key>
GEMINI_MODEL=gemini-1.5-flash

# --- CORS lockdown (Day 24) ------------------------------------------------
# Comma-separated origins. MUST match the Vercel frontend URL exactly or
# the browser will block every /analyse call from the React app.
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app

# --- Scheduler (Day 20) ----------------------------------------------------
# Background source-side polling. Disabled by default on the 1 GB VM to
# protect the memory budget. Flip to `true` after the box has been stable
# for a few hours under demo load.
SCHEDULER_ENABLED=false

# --- App env ---------------------------------------------------------------
APP_ENV=prod
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

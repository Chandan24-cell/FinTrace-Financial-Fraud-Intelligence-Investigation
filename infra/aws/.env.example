# Sentinel-G — AWS Lightsail deployment env template.
# Copy this to `.env` on the VM, fill every value, then `docker compose up -d`.
# DO NOT commit the filled-in `.env` — it's already in the repo's .gitignore.

# --- Caddy reverse-proxy ---------------------------------------------------
# Default uses sslip.io free wildcard DNS — replace `<vm-public-ip>` with the
# Lightsail static IP and the domain works immediately, no DNS provider.
# Once you have a real domain, swap this for the apex (e.g. api.example.com)
# AND point that record at the VM IP in your DNS provider, THEN restart Caddy.
DOMAIN=<vm-public-ip>.sslip.io

# --- Neo4j (co-located in this compose stack) ------------------------------
# `neo4j` resolves to the Neo4j container via Docker's internal DNS — this
# URI never leaves the VM. Generate the password once with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set-with-secrets.token_urlsafe-24>
NEO4J_DATABASE=neo4j

# --- FastAPI auth ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<64-hex-chars>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
RATE_LIMIT_PER_MIN=60

# --- Gemini Flash narrative ------------------------------------------------
# https://aistudio.google.com/apikey — free tier 60 req/min is plenty for demo.
GEMINI_API_KEY=<your-google-ai-studio-key>
GEMINI_MODEL=gemini-1.5-flash

# --- CORS lockdown (Day 24) ------------------------------------------------
# Comma-separated origins. MUST match the Vercel frontend URL exactly or
# the browser will block every /analyse call from the React app.
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app

# --- Scheduler (Day 20) ----------------------------------------------------
# Background source-side polling. Safe to enable on the 4 GB Lightsail box
# (~3.2 GB committed at peak, 800 MB headroom). Flip to `false` if you see
# OOMs in `docker compose logs sentinel-g-api`.
SCHEDULER_ENABLED=true

# --- App env ---------------------------------------------------------------
APP_ENV=prod
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

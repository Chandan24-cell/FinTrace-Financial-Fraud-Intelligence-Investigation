# =============================================================================
# Sentinel-G — environment contract (PRD v4.0)
# Copy to .env.local and fill in real values. .env.local is gitignored.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
APP_ENV=dev                         # dev | staging | prod
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# --- FastAPI / backend ------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=YOUR_JWT_SECRET   # python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
# Sliding-window rate limit per JWT (per IP for anonymous). PRD §10 Day 24.
# Leave unset (or 0) to let backend/app/config.py pick a per-env default:
#   dev=200, staging=120, prod=60. Pin explicitly to override.
RATE_LIMIT_PER_MIN=0

# --- Neo4j (Railway Docker neo4j:5-community + GDS) ------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=PLACEHOLDER_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Sentinel-G

# --- Mistral (narrative only — PRD §5.5) ------------------------------
MISTRAL_API_KEY=PLACEHOLDER_MISTRAL_API_KEY
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- GitHub MCP server ------------------------------------------------------
GITHUB_TOKEN=PLACEHOLDER_GITHUB_TOKEN     # repo scope; used by .mcp.json github server

# --- Deployment targets (placeholders) -------------------------------------
FLY_API_TOKEN=PLACEHOLDER_FLY_TOKEN
RAILWAY_TOKEN=PLACEHOLDER_RAILWAY_TOKEN
VERCEL_TOKEN=PLACEHOLDER_VERCEL_TOKEN

# --- Public data sources (PRD §10) -----------------------------------------
MCA21_API_KEY=PLACEHOLDER_MCA21_KEY
CERSAI_API_KEY=PLACEHOLDER_CERSAI_KEY
BSE_SME_API_KEY=PLACEHOLDER_BSE_KEY

# --- ML training (Phase 1–4) -----------------------------------------------
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=./.torch_cache
ML_ARTIFACT_DIR=./ml/artifacts

# --- Sentry / observability (optional) -------------------------------------
SENTRY_DSN=
